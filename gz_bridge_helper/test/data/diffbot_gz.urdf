<?xml version="1.0"?>
<!-- A small differential-drive robot, written by hand for the tests of gz_bridge_helper. -->
<robot name="diffbot">
  <link name="base_link">
    <visual><geometry><box size="0.4 0.2 0.1"/></geometry></visual>
    <collision><geometry><box size="0.4 0.2 0.1"/></geometry></collision>
    <inertial><mass value="5.0"/><inertia ixx="0.03" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.09"/></inertial>
  </link>

  <link name="left_wheel_link">
    <visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual>
    <collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
    <inertial><mass value="0.4"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="0 0.12 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></visual>
    <collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="0.05" length="0.03"/></geometry></collision>
    <inertial><mass value="0.4"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="0 -0.12 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="caster_link">
    <visual><geometry><sphere radius="0.025"/></geometry></visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
    <inertial><mass value="0.1"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/><child link="caster_link"/>
    <origin xyz="-0.15 0 -0.025"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.03 0.06 0.03"/></geometry></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.2 0 0.08"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin rpy="-1.5707963 0 -1.5707963"/></joint>
  <link name="imu_link">
    <visual><geometry><box size="0.03 0.03 0.01"/></geometry></visual>
    <inertial><mass value="0.02"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.06"/></joint>
  <link name="depth_link">
    <visual><geometry><box size="0.03 0.06 0.03"/></geometry></visual>
    <inertial><mass value="0.05"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
  <joint name="depth_joint" type="fixed"><parent link="base_link"/><child link="depth_link"/><origin xyz="0.2 0.05 0.08"/></joint>
  <link name="laser_link">
    <visual><geometry><cylinder radius="0.035" length="0.045"/></geometry></visual>
    <inertial><mass value="0.2"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0 0 0.1"/></joint>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/front_cam/image</topic>
      <camera><horizontal_fov>1.2</horizontal_fov><image><width>320</width><height>240</height></image><clip><near>0.1</near><far>50</far></clip></camera>
    </sensor>
  </gazebo>
  <gazebo reference="imu_link">
    <sensor name="body_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
    </sensor>
  </gazebo>
  <gazebo reference="depth_link">
    <sensor name="depth" type="depth_camera">
      <update_rate>10</update_rate>
      <topic>/depth</topic>
    </sensor>
  </gazebo>
</robot>
